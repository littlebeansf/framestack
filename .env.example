# Framestack — environment variables
# Copy to .env for local development (gitignored)

# ── Server ──────────────────────────────────────────────────────────────────
# PORT=5000            # default

# ── Database ────────────────────────────────────────────────────────────────
# Dev (default — no config needed):
#   Uses ./data.db automatically

# Production (Railway + Turso embedded replica):
#   DATABASE_URL=file:./data.db
#   LIBSQL_SYNC_URL=libsql://<your-db>.turso.io
#   LIBSQL_AUTH_TOKEN=<your-token>
#   LIBSQL_SYNC_INTERVAL=30    # optional: background sync every 30s
